// Response schema for the `risk-analyzer` subagent.
// Envelope and final-message contract: see the agent-response-protocol skill.
// Completed shape:
{
  "status": "completed",
  "workPlanId": "string", // Unique identifier for the work plan, matching the regex WP-[0-9]{3}
  "planOutputPath": "string", // Path to the generated risk plan document
  "risksIdentified": [
    {
      "riskId": "string", // Unique identifier for the risk, matching the regex RISK-[0-9]{3}
      "description": "string", // Description of the identified risk
      "impact": "string", // Potential impact of the risk on the project
      "severity": "low|medium|high|critical",
      "mitigationStrategy": "string" // Mitigation strategy for the identified risk
    }
  ]
}
// Blocked shape:
// {
//   "status": "blocked",
//   "reason": "work_plan_not_found|input_missing",
//   "detail": "What is missing and what would unblock the agent"
// }
