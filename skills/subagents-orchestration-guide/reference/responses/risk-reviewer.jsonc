// Response schema for the `risk-reviewer` subagent.
// Envelope and final-message contract: see the agent-response-protocol skill.
// Completed shape:
{
  "status": "completed",
  "riskReviewPath": "docs/plans/risk/{workPlanId}/{workPlanId}-risk-review.md", // path to the risk review document
  "riskRemediationRequired": true, // true if any risk deviation requires remediation
  "riskRemediationCount": 0, // total number of deviations requiring remediation
  "riskRemediations": [
    {
      "riskId": "RISK-001", // ID of the risk from the risk plan, matching RISK-[0-9]{3}
      "filePath": "cmd/main.go", // file where the deviation was identified
      "description": "Fernet key read from plaintext config instead of secrets manager", // the deviation found
      "severity": "low|medium|high|critical",
      "remediationAction": "Load the Fernet key from the secrets manager at startup and fail closed if unavailable"
    }
  ],
  "remediationTaskPath": "docs/plans/tasks/{workPlanId}/TASK-RISK-REMEDIATION.md" // null if no deviations were found
}
// Blocked shape:
// {
//   "status": "blocked",
//   "reason": "risk_plan_not_found|manifest_not_found",
//   "detail": "What is missing and what would unblock the agent"
// }
