// Response schema for the `task-executor` subagent.
// Envelope and final-message contract: see the agent-response-protocol skill.
// Completed shape:
{
  "status": "completed",
  "taskId": "TASK-001", // from the task file
  "changeSummary": "string", // specific summary of what was implemented
  "filesModified": ["specific/file/path1"], // consumed by the orchestrator to update the execution manifest
  "testsAdded": ["created/test/file/path"] // consumed by the orchestrator to update the execution manifest
}
// Blocked shape (reasons):
//   "investigation_target_not_found" — task file missing/unreadable, or no Target Files section
//   "out_of_scope_file"              — change would require editing a file outside the Target Files list
//   "incomplete_task"                — completion criteria left incomplete or uncertain
// {
//   "status": "blocked",
//   "reason": "investigation_target_not_found|out_of_scope_file|incomplete_task",
//   "taskId": "TASK-001",
//   "detail": "What is missing or out of scope, and what would unblock the task"
// }
