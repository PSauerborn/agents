// Response schema for the `security-reviewer` subagent.
// Envelope and final-message contract: see the agent-response-protocol skill.
// Reviewer shape: every reviewer returns findings[], remediationRequired, remediationTaskPath.
// Completed shape:
{
  "status": "completed",
  "findings": [
    {
      "category": "string", // short name of the weakness, e.g. "SQL injection", "missing authorization check"; free text, not an enum
      "cwe": "CWE-89", // the closest CWE identifier, or null if none applies
      "filePath": "src/api/upload.py",
      "line": 42,
      "description": "string", // the vulnerability, stated concretely
      "evidence": "string", // concrete attack scenario
      "severity": "low|medium|high|critical", // reflects exploitability and impact
      "requiredFix": "string"
    }
  ],
  "remediationRequired": true, // true if any finding requires a code change
  "remediationTaskPath": "{planDir}/tasks/TASK-SEC-REMEDIATION.md" // null when remediationRequired is false
}
// Blocked shape:
// {
//   "status": "blocked",
//   "reason": "manifest_not_found",
//   "detail": "What is missing and what would unblock the agent"
// }
