// Response schema for the `documenter` subagent.
// Envelope and final-message contract: see the agent-response-protocol skill.
// Completed shape:
{
  "status": "completed",
  "workPlanId": "string", // Unique identifier for the work plan, matching the regex WP-[0-9]{3}
  "changesetPath": "docs/plans/changesets/{workPlanId}/{workPlanId}-changeset.md", // path to the changeset document
  "documentationUpdates": [
    {
      "filepath": "string", // path to updated file
      "type": "docstring|change_diff|openapi|readme|other", // document type
      "description": "string"
    }
  ]
}
// Blocked shape:
// {
//   "status": "blocked",
//   "reason": "manifest_not_found",
//   "detail": "What is missing and what would unblock the agent"
// }
