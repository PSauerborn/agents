// Response schema for the `frontend-designer` subagent.
// Envelope and final-message contract: see the agent-response-protocol skill.
// Completed shape:
{
  "status": "completed",
  "designSetId": "DES-001", // matches DES-[0-9]{3}
  "options": [ // exactly 3 entries, one per design option
    {
      "optionNumber": 1, // 1..3
      "name": "string", // short label, used when presenting choices to the user
      "summary": "string", // 1-2 sentence pitch of the design approach
      "outputPath": "docs/designs/{designSetId}/{designSetId}-option-{n}.md", // design option document
      "mockupPath": "docs/designs/{designSetId}/{designSetId}-option-{n}.html" // self-contained static HTML mockup
    }
  ]
}
// Blocked shape:
// {
//   "status": "blocked",
//   "reason": "spec_not_found|no_ui_scope",
//   "detail": "What is missing and what would unblock the agent"
// }
