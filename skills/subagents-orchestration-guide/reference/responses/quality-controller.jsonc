// Response schema for the `quality-controller` subagent.
// Envelope and final-message contract: see the agent-response-protocol skill.
// Completed shape:
{
  "status": "completed",
  "violationsFound": false, // true if any coding standards violations were found
  "violationsCount": 0, // total number of violations found
  "violations": [
    {
      "standardsFile": "GENERAL.md", // coding standards file containing the violated rule
      "ruleId": "GEN-001", // ID of the violated rule
      "filePath": "cmd/main.go", // file containing the violation
      "line": 42, // line the violation anchors to
      "description": "Log level not configured via environment var"
    }
  ],
  "qualityReportPath": "docs/plans/quality/{workPlanId}/{workPlanId}-quality-report.md",
  "qcRemediationRequired": true, // true if any violation requires remediation
  "remediationTaskPath": "docs/plans/tasks/{workPlanId}/TASK-QC-REMEDIATION.md" // null if no violations were found
}
// Blocked shape:
// {
//   "status": "blocked",
//   "reason": "manifest_not_found|standards_unreadable",
//   "detail": "What is missing and what would unblock the agent"
// }
