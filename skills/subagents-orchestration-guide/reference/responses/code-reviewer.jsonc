// Response schema for the `code-reviewer` subagent.
// Envelope and final-message contract: see the agent-response-protocol skill.
// Reviewer shape: every reviewer returns findings[], remediationRequired, remediationTaskPath.
// Completed shape:
{
  "status": "completed",
  "findings": [
    {
      "category": "correctness|edge-case|design|test-coverage|standards",
      "ruleId": "GO-018", // standards findings only: the violated statement ID; null otherwise
      "filePath": "src/orders/checkout.py",
      "line": 42,
      "description": "string", // the defect, stated concretely
      "evidence": "string", // the failure scenario (concrete input/state), or the standard's requirement
      "severity": "low|medium|high|critical",
      "requiredFix": "string"
    }
  ],
  "remediationRequired": true, // true if any finding requires a code change
  "remediationTaskPath": "{planDir}/tasks/TASK-CODE-REVIEW-REMEDIATION.md" // null when remediationRequired is false
}
// Blocked shape:
// {
//   "status": "blocked",
//   "reason": "manifest_not_found|spec_not_found|standards_unreadable",
//   "detail": "What is missing and what would unblock the agent"
// }
