// Response schema for the `work-planner` subagent.
// Envelope and final-message contract: see the agent-response-protocol skill.
// Completed shape:
{
  "status": "completed",
  "workPlanId": "string", // Unique identifier for the work plan, matching the regex WP-[0-9]{3}
  "planOutputPath": "string" // Path to the generated work plan document (docs/plans/YYYY-MM-DD-{workPlanId}.md)
}
// Blocked shape:
// {
//   "status": "blocked",
//   "reason": "spec_not_found|input_missing|design_not_found|plan_conflict",
//   "detail": "What is missing and what would unblock the agent"
// }
