// Response schema for the `acceptance-validator` subagent.
// Envelope and final-message contract: see the agent-response-protocol skill.
// Reviewer shape: every reviewer returns findings[], remediationRequired, remediationTaskPath.
// Completed shape:
{
  "status": "completed",
  "findings": [ // one entry per acceptance criterion in the spec, including those that are met
    {
      "criterionId": "AC-1",
      "verdict": "met|not_met|unverifiable",
      "evidence": "string", // file:line and/or test executed with its result; empty only for unverifiable
      "gap": "string" // not_met: what is absent or wrong; unverifiable: what clarification is needed; null for met
    }
  ],
  "remediationRequired": true, // true if any criterion is not_met
  "remediationTaskPath": "{planDir}/tasks/TASK-ACCEPTANCE-REMEDIATION.md", // null when remediationRequired is false
  "escalationRequired": false // true if any criterion is unverifiable — the orchestrator must ask the user, not remediate
}
// Blocked shape:
// {
//   "status": "blocked",
//   "reason": "spec_not_found|plan_not_found|manifest_not_found",
//   "detail": "What is missing and what would unblock the agent"
// }
