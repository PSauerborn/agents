// Response schema for the `task-decomposer` subagent.
// Envelope and final-message contract: see the agent-response-protocol skill.
// Completed shape:
{
  "status": "completed",
  "taskFiles": [
    {
      "taskName": "string", // Name of the task
      "taskId": "string", // Task ID matching TASK-[0-9]{3}
      "taskFilePath": "string", // Path to the generated task file (docs/plans/tasks/{workPlanId}/TASK-{number}.md)
      "description": "string", // Description of the task
      "targetFiles": ["string"], // The task's write set — used by the orchestrator for the parallel-execution disjointness guard
      "dependencies": ["string"], // Task IDs this task depends on (empty if none)
      "completionCriteria": "string" // What constitutes completion for this task
    }
  ]
}
// Blocked shape:
// {
//   "status": "blocked",
//   "reason": "work_plan_not_found|plan_not_decomposable",
//   "detail": "What is missing and what would unblock the agent"
// }
