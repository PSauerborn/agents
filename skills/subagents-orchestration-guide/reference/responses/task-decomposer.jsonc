// Response schema for the `task-decomposer` subagent.
// Envelope and final-message contract: see the agent-response-protocol skill.
// Completed shape:
{
  "status": "completed",
  "taskFiles": [
    {
      "taskId": "TASK-001", // matches TASK-[0-9]{3}
      "taskName": "string",
      "outputPath": "docs/plans/{workPlanId}/tasks/TASK-001.md",
      "targetFiles": ["string"], // the task's write set — used by the orchestrator's parallel-execution guard
      "dependencies": ["TASK-000"], // task IDs this task depends on (empty if none)
      "acceptanceCriteria": ["AC-1"] // criterion IDs covered, or ["infrastructure"]
    }
  ]
}
// Blocked shape:
// {
//   "status": "blocked",
//   "reason": "work_plan_not_found|plan_not_decomposable|coverage_gap",
//   "detail": "What is missing and what would unblock the agent; for coverage_gap, the uncovered AC-* IDs or the tasks citing none"
// }
