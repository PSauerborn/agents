// Response schema for the `validation-runner` subagent.
// Envelope and final-message contract: see the agent-response-protocol skill.
// Reviewer shape: every reviewer returns findings[], remediationRequired, remediationTaskPath.
// Completed shape:
{
  "status": "completed",
  "verdict": "verified|partial|failed", // verified: every discovered check ran and passed; partial: changeset checks pass but some checks could not be run or unrelated pre-existing failures remain; failed: a check attributable to the changeset failed
  "checksRun": [
    {
      "type": "build|test|lint|format|typecheck|acceptance",
      "command": "string", // exact command executed
      "result": "passed|failed|not-run",
      "summary": "string" // one-line result (e.g. "142 passed, 0 failed"; for not-run, the reason)
    }
  ],
  "findings": [
    {
      "command": "string", // the failing command
      "evidence": "string", // relevant excerpt of the failure output (failing test/target names)
      "suspectedFiles": ["string"] // changeset files correlated with the failure
    }
  ],
  "remediationRequired": true, // true when verdict is failed
  "remediationTaskPath": "{planDir}/tasks/TASK-VALIDATION-REMEDIATION.md" // null when remediationRequired is false
}
// Blocked shape:
// {
//   "status": "blocked",
//   "reason": "manifest_not_found|checks_not_discoverable",
//   "detail": "What is missing and what would unblock the agent"
// }
